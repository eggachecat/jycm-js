{
  "name": "jycm",
  "version": "0.1.0",
  "description": "Business-aware semantic JSON diff and RFC 6902 patching for JavaScript and TypeScript",
  "author": "sunao_0626@hotmail.com",
  "license": "MIT",
  "homepage": "https://github.com/eggachecat/jycm-js",
  "repository": "https://github.com/eggachecat/jycm-js",
  "keywords": [
    "json-diff",
    "json-patch",
    "rfc6902",
    "semantic-diff",
    "typescript"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE.txt"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "typings": "dist/index.d.ts",
  "devDependencies": {
    "@babel/core": "^7.23.7",
    "@babel/preset-env": "^7.23.8",
    "@types/jest": "^29.5.11",
    "babel-loader": "^9.1.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && webpack --config webpack.config.js",
    "test": "jest --runInBand",
    "check": "jest --runInBand && node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && webpack --config webpack.config.js",
    "pub": "npm version patch --force && npm publish"
  }
}
